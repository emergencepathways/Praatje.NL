<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the game-independent code. Run: dotnet run -project tests/Praatje.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Praatje/Text/*.cs" LinkBase="Text" />
    <Compile Include="../../Praatje/Vocab/VocabEntry.cs" LinkBase="Vocab" />
    <Compile Include="../../Praatje/Vocab/AnkiText.cs" LinkBase="Vocab" />
    <Compile Include="../../Praatje/Lookup/Wiktionary.cs" LinkBase="Lookup" />
  </ItemGroup>
</Project>
